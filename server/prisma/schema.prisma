generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String       @id @default(cuid())
  name             String
  email            String       @unique
  passwordHash     String
  role             String
  department       String?
  status           String       @default("ACTIVE")
  lastLogin        DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  auditLogs        AuditLog[]
  collectedSamples Sample[]     @relation("CollectedBy")
  validatedResults TestResult[] @relation("ValidatedBy")
  dispatchedReports Report[]    @relation("DispatchedBy")
  qcEntries        QCEntry[]
}

model Patient {
  id                String    @id @default(cuid())
  patientId         String    @unique
  firstName         String
  lastName          String
  dateOfBirth       DateTime
  gender            String
  phone             String
  email             String?
  address           String?
  emergencyContact  String?
  emergencyPhone    String?
  insuranceProvider String?
  policyNumber      String?
  nationality       String?
  referringDoctor   String?
  referringFacility String?
  clinicalHistory   String?
  allergies         String    @default("[]")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  visits            Visit[]
  invoices          Invoice[]
}

model Visit {
  id                String      @id @default(cuid())
  visitId           String      @unique
  patientId         String
  patient           Patient     @relation(fields: [patientId], references: [id])
  type              String      @default("WALK_IN")
  referralLetter    String?
  referringDoctor   String?
  referringFacility String?
  clinicalHistory   String?
  urgency           String      @default("ROUTINE")
  status            String      @default("REGISTERED")
  registeredAt      DateTime    @default(now())
  samples           Sample[]
  invoice           Invoice?
  report            Report?
}

model Sample {
  id            String          @id @default(cuid())
  specimenId    String          @unique
  visitId       String
  visit         Visit           @relation(fields: [visitId], references: [id])
  specimenType  String
  volume        Float?
  container     String
  collectedById String?
  collectedBy   User?           @relation("CollectedBy", fields: [collectedById], references: [id])
  collectedAt   DateTime?
  condition     String          @default("ACCEPTABLE")
  conditionNote String?
  status        String          @default("PENDING_COLLECTION")
  testOrders    TestOrder[]
  createdAt     DateTime        @default(now())
}

model TestOrder {
  id            String        @id @default(cuid())
  orderId       String        @unique
  sampleId      String
  sample        Sample        @relation(fields: [sampleId], references: [id])
  testPanelId   String?
  testPanel     TestPanel?    @relation(fields: [testPanelId], references: [id])
  testCatalogId String
  testCatalog   TestCatalog   @relation(fields: [testCatalogId], references: [id])
  urgency       String        @default("ROUTINE")
  status        String        @default("PENDING")
  tatDeadline   DateTime?
  orderedAt     DateTime      @default(now())
  result        TestResult?
  billingItem   BillingItem?
  referralTest  ReferralTest?
}

model TestCatalog {
  id              String          @id @default(cuid())
  code            String          @unique
  name            String
  category        String
  department      String
  specimenTypes   String          @default("[]")
  container       String
  sampleVolume    Float
  tatHoursRoutine Int             @default(24)
  tatHoursUrgent  Int             @default(6)
  tatHoursStat    Int             @default(2)
  price           Float
  parameters      TestParameter[]
  testOrders      TestOrder[]
  panelItems      TestPanelItem[]
  qcMaterials     QCMaterial[]
  active          Boolean         @default(true)
  createdAt       DateTime        @default(now())
}

model TestParameter {
  id              String           @id @default(cuid())
  testCatalogId   String
  testCatalog     TestCatalog      @relation(fields: [testCatalogId], references: [id])
  name            String
  unit            String
  referenceRanges ReferenceRange[]
  sortOrder       Int              @default(0)
  resultValues    ResultValue[]
}

model ReferenceRange {
  id           String        @id @default(cuid())
  parameterId  String
  parameter    TestParameter @relation(fields: [parameterId], references: [id])
  gender       String?
  ageMinYears  Int?
  ageMaxYears  Int?
  normalLow    Float?
  normalHigh   Float?
  criticalLow  Float?
  criticalHigh Float?
  unit         String
}

model TestPanel {
  id          String          @id @default(cuid())
  code        String          @unique
  name        String
  description String?
  price       Float
  items       TestPanelItem[]
  testOrders  TestOrder[]
  active      Boolean         @default(true)
}

model TestPanelItem {
  id            String      @id @default(cuid())
  panelId       String
  panel         TestPanel   @relation(fields: [panelId], references: [id])
  testCatalogId String
  testCatalog   TestCatalog @relation(fields: [testCatalogId], references: [id])
}

model TestResult {
  id               String       @id @default(cuid())
  testOrderId      String       @unique
  testOrder        TestOrder    @relation(fields: [testOrderId], references: [id])
  values           ResultValue[]
  interpretation   String?
  method           String?
  instrument       String?
  runId            String?
  technicianNote   String?
  status           String       @default("PENDING")
  enteredAt        DateTime?
  enteredBy        String?
  validatedAt      DateTime?
  validatedById    String?
  validatedBy      User?        @relation("ValidatedBy", fields: [validatedById], references: [id])
  deltaCheckPassed Boolean?
  deltaCheckNote   String?
  createdAt        DateTime     @default(now())
}

model ResultValue {
  id           String        @id @default(cuid())
  testResultId String
  testResult   TestResult    @relation(fields: [testResultId], references: [id])
  parameterId  String
  parameter    TestParameter @relation(fields: [parameterId], references: [id])
  value        String
  numericValue Float?
  flag         String        @default("NORMAL")
  flagNote     String?
}

model QCMaterial {
  id            String      @id @default(cuid())
  name          String
  level         String
  lotNumber     String
  expiryDate    DateTime
  testCatalogId String
  testCatalog   TestCatalog @relation(fields: [testCatalogId], references: [id])
  targetMean    Float
  targetSD      Float
  entries       QCEntry[]
  active        Boolean     @default(true)
}

model QCEntry {
  id           String     @id @default(cuid())
  qcMaterialId String
  qcMaterial   QCMaterial @relation(fields: [qcMaterialId], references: [id])
  value        Float
  zScore       Float
  rule         String     @default("IN_CONTROL")
  note         String?
  runDate      DateTime   @default(now())
  enteredById  String
  enteredBy    User       @relation(fields: [enteredById], references: [id])
}

model ReferralTest {
  id              String         @id @default(cuid())
  testOrderId     String         @unique
  testOrder       TestOrder      @relation(fields: [testOrderId], references: [id])
  referralLabName String
  referralLabCode String?
  sentAt          DateTime?
  expectedBackAt  DateTime?
  receivedAt      DateTime?
  trackingRef     String?
  status          String         @default("PENDING")
  cost            Float?
  notes           String?
  createdAt       DateTime       @default(now())
}

model Report {
  id             String           @id @default(cuid())
  reportId       String           @unique
  visitId        String           @unique
  visit          Visit            @relation(fields: [visitId], references: [id])
  generatedAt    DateTime?
  dispatchedAt   DateTime?
  dispatchedById String?
  dispatchedBy   User?            @relation("DispatchedBy", fields: [dispatchedById], references: [id])
  deliveryMethod String           @default("[]")
  pdfUrl         String?
  status         String           @default("PENDING")
  amendmentNote  String?
  amendedAt      DateTime?
}

model Invoice {
  id              String        @id @default(cuid())
  invoiceId       String        @unique
  patientId       String
  patient         Patient       @relation(fields: [patientId], references: [id])
  visitId         String        @unique
  visit           Visit         @relation(fields: [visitId], references: [id])
  lineItems       BillingItem[]
  subtotal        Float
  discount        Float         @default(0)
  insuranceAmount Float         @default(0)
  vatAmount       Float         @default(0)
  totalAmount     Float
  patientBalance  Float
  status          String        @default("UNPAID")
  paidAt          DateTime?
  payments        Payment[]
  createdAt       DateTime      @default(now())
}

model BillingItem {
  id          String     @id @default(cuid())
  invoiceId   String
  invoice     Invoice    @relation(fields: [invoiceId], references: [id])
  testOrderId String?    @unique
  testOrder   TestOrder? @relation(fields: [testOrderId], references: [id])
  description String
  quantity    Int        @default(1)
  unitPrice   Float
  discount    Float      @default(0)
  total       Float
}

model Payment {
  id         String        @id @default(cuid())
  invoiceId  String
  invoice    Invoice       @relation(fields: [invoiceId], references: [id])
  amount     Float
  method     String
  reference  String?
  recordedAt DateTime      @default(now())
  recordedBy String
}

model CorporateClient {
  id           String   @id @default(cuid())
  name         String
  code         String   @unique
  contactName  String?
  contactPhone String?
  contactEmail String?
  address      String?
  discountRate Float    @default(0)
  creditLimit  Float    @default(0)
  balance      Float    @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model Notification {
  id           String           @id @default(cuid())
  userId       String
  type         String
  title        String
  message      String
  resourceLink String?
  read         Boolean          @default(false)
  createdAt    DateTime         @default(now())
}

model AuditLog {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  action       String
  resourceType String
  resourceId   String
  ipAddress    String?
  metadata     String?
  createdAt    DateTime @default(now())
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
