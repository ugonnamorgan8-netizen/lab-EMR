{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm install --include=dev && npm run prisma:generate --workspace server && npm run build",
    "watchPatterns": [
      "/client/**",
      "/server/**",
      "/shared/**",
      "/package.json",
      "/package-lock.json",
      "/tsconfig.base.json",
      "/railway.json"
    ]
  },
  "deploy": {
    "startCommand": "npm run start",
    "preDeployCommand": "npm run prisma:push --workspace server && npm run seed --workspace server",
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
